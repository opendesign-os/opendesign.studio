{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenDesign Studio",
  "mainBinaryName": "opendesign",
  "version": "0.1.0",
  "identifier": "studio.opendesign.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5200",
    "beforeDevCommand": "pnpm --filter @opendesign/web dev",
    "beforeBuildCommand": "pnpm --filter @opendesign/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenDesign Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
