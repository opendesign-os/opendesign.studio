{
  "name": "opendesign",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "desktop": "pnpm --filter @opendesign/native desktop",
    "desktop:build": "pnpm --filter @opendesign/native desktop:build",
    "android": "pnpm --filter @opendesign/native android",
    "android:build": "pnpm --filter @opendesign/native android:build",
    "ios": "pnpm --filter @opendesign/native ios",
    "ios:build": "pnpm --filter @opendesign/native ios:build",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
